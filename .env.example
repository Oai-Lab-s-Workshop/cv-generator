# Required for docker compose startup. Set local-only values; do not commit real secrets.
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
POCKETBASE_PORT=8090
POCKETBASE_INTERNAL_PORT=8090
MCP_PORT=8081
MCP_INTERNAL_PORT=8081
FRONTEND_PORT=4200
FRONTEND_INTERNAL_PORT=4200
FRONTEND_BASE_URL=http://localhost:${FRONTEND_PORT:-4200}
PB_URL=http://localhost:${POCKETBASE_PORT:-8090}
# WARNING: Use HTTPS for non-local deployments
POCKETBASE_BASE_URL=http://pocketbase:${POCKETBASE_INTERNAL_PORT:-8090}
MCP_BASE_URL=http://localhost:${MCP_PORT:-8081}
POCKETBASE_SERVICE_USER_EMAIL=
POCKETBASE_SERVICE_USER_PASSWORD=
MCP_PUBLIC_BASE_URL=
MCP_OAUTH_JWK=
MCP_OAUTH_ACCESS_TOKEN_TTL=1h
MCP_OAUTH_REFRESH_TOKEN_TTL=90d
MCP_OAUTH_ALLOWED_REDIRECT_URI_PATTERNS=https://claude.ai/*
SEED_USER_PASSWORD=
RESUMATE_AI_TOKEN=
BUG_REPORT_URL=

# CI test thresholds
# Desktop:  desktop/bunfig.toml  [test].coverageThreshold
# Frontend: frontend/jest.config.js  coverageThreshold (overridable via env: COVERAGE_THRESHOLD_*)
# MCP:      GitHub repository variable TEST_PASS_THRESHOLD_MCP (default: 100)
